# Local Postgres: `docker compose up -d db`
# The app connects as a RESTRICTED role (not a superuser, no BYPASSRLS) so Postgres row-level
# security actually isolates tenants — a superuser silently bypasses it. docker-compose creates
# this role; see docs/ISOLATION.md.
DATABASE_URL="postgresql://wholesale_app:wholesale_app@localhost:5432/wholesale?schema=public"
# Used by `prisma migrate` and the seed: the database owner.
DIRECT_URL="postgresql://wholesale:wholesale@localhost:5432/wholesale?schema=public"
# Used only by `npm run test`. The database name MUST end in "_test" — the
# suite wipes it (tests/global-setup.ts refuses to run otherwise).
TEST_DATABASE_URL="postgresql://wholesale:wholesale@localhost:5432/wholesale_test?schema=public"
# Optional: the restricted role against the test database. When set, the domain tests run their
# application queries as that role, so every test exercises row-level security.
TEST_APP_DATABASE_URL="postgresql://wholesale_app:wholesale_app@localhost:5432/wholesale_test?schema=public"
# generate with: openssl rand -base64 32
AUTH_SECRET=""
# WhatsApp Cloud API (optional; app degrades gracefully without)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# AI product matching, including image input (optional). Also required to run the eval harness:
# npm run ai:eval (src/lib/ai/eval.ts) — "the AI is never called production-ready without
# evaluation against defined acceptance criteria" (VISION.md).
OPENAI_API_KEY=""
# Optional override — src/lib/ai/engine.ts's default model id couldn't be confirmed with full
# confidence at the time this was written (see docs/PROGRESS.md); set this if it's wrong/retired.
OPENAI_MODEL=""
# Email notifications via Resend (optional; app degrades gracefully without — in-app
# notifications still work, this just skips the email channel layered on top of them)
RESEND_API_KEY=""
EMAIL_FROM=""
# Base URL used only to build absolute links in emails (e.g. "https://app.example.com").
# Without it, a notification email still sends, just without a clickable link.
APP_URL=""
# Paystack (optional; app degrades gracefully without — "Get payment link" is hidden and
# the manual "Mark as paid" flow still works). Webhook events are signed with this same
# secret key (no separate webhook secret) — see src/lib/payments.ts.
PAYSTACK_SECRET_KEY=""
# Error tracking (optional; app degrades gracefully without — Sentry.init() is simply never
# called, so every Sentry call elsewhere becomes a safe no-op). See sentry.server.config.ts
# and docs/MONITORING_AND_BACKUPS.md.
SENTRY_DSN=""

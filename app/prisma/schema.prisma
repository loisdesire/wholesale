// Phase 1 data model.
// Tenant boundary (Organization) is present from day one so Phase 3 multi-tenancy
// doesn't require a schema rewrite, even though isolation is only enforced at the
// application layer (single tenant) for now.
//
// Datasource is PostgreSQL (docker-compose.yml for local dev). Money is stored as
// integer cents rather than `Decimal` — a deliberate choice that predates the
// SQLite -> Postgres move and keeps arithmetic exact and simple.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The application connects as a restricted role (no superuser, no BYPASSRLS) so
  // row-level security is actually enforced; migrations run as the owner.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum ConversationChannel {
  WHATSAPP
}

enum ConversationStatus {
  NEW
  AI_HANDLING
  AWAITING_STAFF
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  STAFF
}

// Return lifecycle: a request is approved or rejected by the owner (a human
// decision, never automatic); an approved return is RECEIVED once the goods are
// back and their stock has been recorded.
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
}

// RETURN: goods coming back from a shipped order. CANCELLATION: an owner
// cancelled an order that was already paid — nothing ships back, but the
// money is owed (same refund workflow). UNSHIPPED: an owner closed a
// part-shipped order short, so the value of what never shipped is owed back.
enum ReturnKind {
  RETURN
  CANCELLATION
  UNSHIPPED
}

enum ReturnItemCondition {
  RESELLABLE
  DAMAGED
}

// NONE until the owner approves; PENDING = money owed to the customer;
// REFUNDED = the owner recorded that it was paid out.
enum RefundStatus {
  NONE
  PENDING
  REFUNDED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

// Reasons an inventory ledger entry exists. Every stock figure (physical,
// reserved, damaged, available) is a SUM over the ledger's delta columns —
// never a column that gets edited directly. See src/lib/stock-effects.ts.
enum StockMovementReason {
  INITIAL_STOCK
  PURCHASE_RECEIVED
  SALE_RESERVED
  SALE_FULFILLED
  RESERVATION_RELEASED
  RETURN
  RETURN_DAMAGED
  DAMAGE
  DAMAGE_WRITTEN_OFF
  MANUAL_ADJUSTMENT
}

model Organization {
  id                    String   @id @default(cuid())
  name                  String
  // Last order number issued (ORD-<n>). Incremented atomically when a draft is
  // created, so concurrent drafts can never be given the same reference.
  orderSeq              Int      @default(1000)
  returnSeq             Int      @default(1000)
  // The WhatsApp Cloud API phone number id this organization receives messages on,
  // so an inbound webhook can be routed to the right tenant.
  whatsappPhoneNumberId String?  @unique
  // Per-organization overrides of the default SLA thresholds in src/lib/ops-config.ts
  // (a partial Record<keyof typeof SLA, number>; an absent key uses the default).
  slaOverrides          Json?
  createdAt             DateTime @default(now())

  // Subscription/billing status — foundations only, not final pricing (see
  // src/lib/billing.ts's PLAN_LIMITS). A fresh organization starts TRIALING; call
  // startTrial() to set trialEndsAt (a schema default can't compute "now + N days").
  plan                      Plan               @default(STARTER)
  subscriptionStatus        SubscriptionStatus @default(TRIALING)
  trialEndsAt               DateTime?
  currentPeriodEnd          DateTime?
  // A reusable card authorization captured from a verified Paystack webhook (never user input;
  // see parsePaystackWebhookEvent/recordSubscriptionPayment) — the raw material a real tokenized
  // recurring subscription needs (src/lib/subscriptions.ts). Set, but not yet acted on: nothing
  // creates a live Paystack subscription from it today, since this app can't yet reliably
  // recognize Paystack's renewal-charge webhook events to keep the ledger in sync if it did. See
  // docs/PROGRESS.md.
  paystackAuthorizationCode String?

  memberships          Membership[]
  products             Product[]
  stockMovements       StockMovement[]
  customers            Customer[]
  conversations        Conversation[]
  orders               Order[]
  returns              OrderReturn[]
  auditLogs            AuditLog[]
  shipments            Shipment[]
  payments             Payment[]
  subscriptionPayments SubscriptionPayment[]
}

// Illustrative tiers only — VISION.md is explicit that final pricing/limits wait for
// real customer needs and costs, not invented here. See src/lib/billing.ts.
enum Plan {
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// The platform billing an organization for its subscription — entirely separate from
// Payment (a customer paying that organization for an order). Same "a row only exists
// once there is verified evidence" rule as Payment: no pending/failed rows, an
// unsuccessful charge attempt leaves no evidence and the period simply isn't paid for.
model SubscriptionPayment {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  plan              Plan
  amountCents       Int
  currency          String       @default("NGN")
  periodStart       DateTime
  periodEnd         DateTime
  // Paystack's transaction reference — globally unique (we generate it), the
  // idempotency key a redelivered webhook is detected and ignored by.
  providerReference String?      @unique
  createdAt         DateTime     @default(now())

  @@index([organizationId])
}

// A user belongs to one or more organizations, with a role in each. The session
// carries the active one; it is re-checked against this table on every request.
// An in-app notice for one user. `dedupeKey` makes creation idempotent: a retried
// job (or a double-fired event) asks for the same notice again and gets no duplicate.
model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  kind           String
  title          String
  body           String?
  href           String?
  dedupeKey      String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([organizationId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           UserRole     @default(STAFF)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  createdAt       DateTime @default(now())
  // Platform operator, not a tenant role — can see (read-only) every organization's overview at
  // /admin. Not self-serve: set directly against the database, same "no self-serve for this"
  // pattern as docs/PILOT_ONBOARDING.md's org onboarding. False for everyone by default,
  // including every organization's own OWNER.
  isPlatformAdmin Boolean  @default(false)

  assignedConversations Conversation[]  @relation("AssignedStaff")
  createdStockMovements StockMovement[]
  createdOrders         Order[]
  requestedReturns      OrderReturn[]   @relation("ReturnRequestedBy")
  decidedReturns        OrderReturn[]   @relation("ReturnDecidedBy")
  auditLogs             AuditLog[]
  memberships           Membership[]
  assignedOrders        Order[]         @relation("OrderAssignee")
  assignedReturns       OrderReturn[]   @relation("ReturnAssignee")
  notifications         Notification[]
  recordedPayments      Payment[]
}

model Product {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  sku               String
  name              String
  // Variant attributes, e.g. {"size":"M","colour":"Black"}. Kept flexible per
  // product category — business-specific attributes (material, model,
  // packaging, ...) are just extra keys, not new columns.
  variantAttributes Json?
  priceCents        Int
  // Cost price, when known — nullable because many businesses won't have it
  // for every SKU from day one. Never used to compute profit until real cost
  // data exists everywhere it's needed (per VISION.md).
  costCents         Int?
  currency          String       @default("NGN")
  // Minimum order quantity — enforced when an order item is added.
  moq               Int          @default(1)
  // Display/stock unit label (e.g. "piece", "carton", "dozen"). Stock
  // movements and order quantities for a product are always in this same
  // unit — this makes the unit explicit per VISION.md rather than silently
  // mixing pieces and cartons; it is not a multi-unit conversion system.
  unit              String       @default("piece")
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  stockMovements StockMovement[]
  orderItems     OrderItem[]
  priceTiers     PriceTier[]
  customerPrices CustomerPrice[]

  @@unique([organizationId, sku])
  @@index([organizationId, active])
  @@index([organizationId, name])
}

// Quantity-break wholesale pricing, e.g. 1-9 units at list price, 10-49 at a
// discount, 50+ at a deeper discount. minQuantity: 1 tiers are equivalent to
// (and should be kept in sync with the intent of) the product's base
// priceCents — see src/lib/pricing.ts for resolution order.
model PriceTier {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  minQuantity Int
  priceCents  Int

  @@unique([productId, minQuantity])
}

model StockMovement {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product             @relation(fields: [productId], references: [id])
  // Effect on each stock figure (see src/lib/stock-effects.ts). available =
  // physical - reserved - damaged, so it is derived, never stored.
  physicalDelta  Int                 @default(0)
  reservedDelta  Int                 @default(0)
  damagedDelta   Int                 @default(0)
  reason         StockMovementReason
  // Free-form pointer to the causing record, e.g. an order reference or PO number.
  reference      String?
  note           String?
  createdAt      DateTime            @default(now())
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id])

  @@index([organizationId, productId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Phone exactly as first recorded/displayed (e.g. "+2348031234567").
  phone          String
  // Digits-only canonical form (see src/lib/phone.ts) — the real identity key,
  // so "0803 123 4567", "+234 803 123 4567" and WhatsApp's "2348031234567"
  // are the same customer instead of three.
  phoneKey       String
  name           String?
  email          String?
  // Set when this record was merged into another (see CustomerMerge). A merged
  // customer is hidden from lists and pickers and its phone number routes to the
  // surviving record; nothing is deleted, so a merge can be undone.
  mergedIntoId   String?
  mergedInto     Customer?    @relation("CustomerMerged", fields: [mergedIntoId], references: [id])
  mergedAt       DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  conversations  Conversation[]
  orders         Order[]
  returns        OrderReturn[]
  addresses      CustomerAddress[]
  prices         CustomerPrice[]
  mergedFrom     Customer[]        @relation("CustomerMerged")
  mergesAsTarget CustomerMerge[]   @relation("MergeTarget")
  mergesAsSource CustomerMerge[]   @relation("MergeSource")

  @@unique([organizationId, phoneKey])
  @@index([organizationId, name])
}

// The record of one customer merge: enough to reverse it exactly. `snapshot`
// lists the ids of everything that moved from source to target, the prices that
// lost a conflict (and stayed on the source), and the target's fields before and
// after.
model CustomerMerge {
  id             String    @id @default(cuid())
  organizationId String
  sourceId       String
  source         Customer  @relation("MergeSource", fields: [sourceId], references: [id])
  targetId       String
  target         Customer  @relation("MergeTarget", fields: [targetId], references: [id])
  performedById  String?
  performedAt    DateTime  @default(now())
  note           String?
  snapshot       Json
  undoneAt       DateTime?
  undoneById     String?

  @@index([organizationId, targetId])
  @@index([sourceId])
}

model CustomerAddress {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  label          String?
  // Free text on purpose: delivery addresses here are written however the
  // customer sends them, and a rigid street/city schema would just be wrong.
  text           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([customerId])
}

// A price agreed with one customer for one product. When present it wins over
// the product's quantity-break tiers and base price (src/lib/pricing.ts).
model CustomerPrice {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  priceCents     Int
  createdAt      DateTime @default(now())

  @@unique([customerId, productId])
}

model Conversation {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id])
  channel        ConversationChannel @default(WHATSAPP)
  status         ConversationStatus  @default(NEW)
  assignedToId   String?
  assignedTo     User?               @relation("AssignedStaff", fields: [assignedToId], references: [id])
  lastMessageAt  DateTime            @default(now())
  createdAt      DateTime            @default(now())

  messages Message[]
  orders   Order[]

  @@index([organizationId, status])
}

model Message {
  id               String                 @id @default(cuid())
  conversationId   String
  conversation     Conversation           @relation(fields: [conversationId], references: [id])
  direction        MessageDirection
  sender           MessageSender
  body             String
  // WhatsApp message id — unique when present, so a re-delivered webhook event
  // can be detected and ignored instead of creating a duplicate message.
  externalId       String?                @unique
  // Outbound only: Meta's delivery-status webhook, applied by src/lib/message-status.ts.
  // Null means "we don't know yet" (an inbound message, or an outbound one with no
  // status webhook received), never a guessed/assumed state.
  deliveryStatus   MessageDeliveryStatus?
  deliveryStatusAt DateTime?
  // Set only when deliveryStatus is FAILED — Meta's own error description, truncated.
  deliveryError    String?
  createdAt        DateTime               @default(now())

  attachments MessageAttachment[]

  @@index([conversationId])
}

// An inbound image (a customer's photo of what they want, a payment screenshot, …) — downloaded
// from WhatsApp's Media API at ingestion time and stored here, since Meta's own media URLs are
// short-lived (src/lib/whatsapp.ts's fetchMediaBytes). No organizationId of its own — a child of
// Message the same way Message is a child of Conversation (see docs/ISOLATION.md).
model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  mimeType  String
  data      Bytes
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([messageId])
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Order {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  reference       String
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  status          OrderStatus   @default(DRAFT)
  totalCents      Int           @default(0)
  currency        String        @default("NGN")
  notes           String?
  deliveryAddress String?
  // Who is responsible for moving this order along, and when it is due (delivery deadline).
  assignedToId    String?
  assignedTo      User?         @relation("OrderAssignee", fields: [assignedToId], references: [id])
  dueAt           DateTime?
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  confirmedAt     DateTime?
  paidAt          DateTime?
  fulfilledAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items     OrderItem[]
  shipments Shipment[]
  returns   OrderReturn[]
  payments  Payment[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
}

enum PaymentMethod {
  /**
   * Recorded by a staff member/owner from outside the app — cash, bank transfer, etc.
   */
  MANUAL
  /**
   * Verified by a signed provider webhook (Paystack) — never from a customer's claim.
   */
  PROVIDER
}

// A row only ever exists here once there is verified evidence of a successful payment —
// a provider's signed webhook, or a human confirming a manual payment. There is no
// "pending" or "failed" Payment: an attempt that didn't succeed leaves no evidence to
// record, so the order simply stays unpaid. "Amount paid" is the SUM of these rows —
// a ledger, like StockMovement — never a column on Order that gets edited directly.
// This is what makes partial and overpaid states representable without a payment ever
// needing to be split, reversed or corrected in place.
model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  method            PaymentMethod
  amountCents       Int
  currency          String        @default("NGN")
  // Paystack's transaction reference — globally unique (we generate it), the
  // idempotency key a redelivered webhook is detected and ignored by. Null for a
  // MANUAL payment, which has no provider transaction behind it.
  providerReference String?       @unique
  // Who recorded a MANUAL payment; null for PROVIDER (verified by the webhook, not a person).
  recordedById      String?
  recordedBy        User?         @relation(fields: [recordedById], references: [id])
  createdAt         DateTime      @default(now())

  @@index([organizationId, orderId])
}

// unitPriceCents is locked at order-confirmation time — a later catalogue price
// change must never silently alter an already-confirmed order's items.
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  variantLabel   String?
  quantity       Int
  unitPriceCents Int
  createdAt      DateTime @default(now())

  returnItems   ReturnItem[]
  shipmentItems ShipmentItem[]
}

// One physical dispatch of (part of) an order. An order can ship in several
// pieces; each piece is a Shipment and moves its units out of physical and
// reserved stock. What has shipped — not what was ordered — is what can be
// returned.
model Shipment {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id])
  reference         String
  carrier           String?
  trackingReference String?
  notes             String?
  createdById       String?
  createdAt         DateTime     @default(now())

  items ShipmentItem[]

  @@unique([organizationId, reference])
  @@index([orderId])
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int

  @@index([shipmentId])
  @@index([orderItemId])
}

// A customer sending goods back from a fulfilled order. refundCents is fixed
// when the return is requested, from the order items' *locked* prices — never
// from today's catalogue price.
model OrderReturn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  reference      String
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  // Denormalized from the order so balances can be summed per customer.
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  kind           ReturnKind   @default(RETURN)
  status         ReturnStatus @default(REQUESTED)
  reason         String
  // Value of the goods at the order's locked prices; refundCents is what the owner
  // actually approved paying back (equal, unless they approved a partial refund).
  valueCents     Int
  refundCents    Int
  refundStatus   RefundStatus @default(NONE)
  refundNote     String?
  requestedById  String?
  requestedBy    User?        @relation("ReturnRequestedBy", fields: [requestedById], references: [id])
  decidedById    String?
  decidedBy      User?        @relation("ReturnDecidedBy", fields: [decidedById], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("ReturnAssignee", fields: [assignedToId], references: [id])
  decisionNote   String?
  decidedAt      DateTime?
  receivedAt     DateTime?
  refundedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items ReturnItem[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([orderId])
  @@index([customerId])
}

model ReturnItem {
  id          String              @id @default(cuid())
  returnId    String
  return      OrderReturn         @relation(fields: [returnId], references: [id])
  orderItemId String
  orderItem   OrderItem           @relation(fields: [orderItemId], references: [id])
  quantity    Int
  condition   ReturnItemCondition

  @@index([returnId])
  @@index([orderItemId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entity         String
  entityId       String
  action         String
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entity, entityId])
}
